# Copiá este archivo a ".env" y completá tus datos reales.
# ".env" NUNCA se sube al repo (agregalo a .gitignore).

# --- Ingesta (IMAP): la casilla donde llega el CSV a procesar ---
IMAP_HOST=imap.gmail.com
IMAP_USER=tu_casilla@gmail.com
IMAP_PASSWORD=tu_contraseña_de_aplicacion
IMAP_ASUNTO_FILTRO=[VENTAS TOTALES]

# --- Salida (SMTP): desde dónde y a quién se manda el resultado ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=tu_casilla@gmail.com
EMAIL_PASSWORD=tu_contraseña_de_aplicacion
EMAIL_DESTINATARIO=destinatario@ejemplo.com
EMAIL_SOPORTE=soporte@ejemplo.com

# --- LLM (redacción del cuerpo del email) ---
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=800
